# PostgreSQL 18 connection string. Replace the placeholders.
# Do not put a real password in this file.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?schema=public"

# Session signing secret. Use at least 32 random characters.
# Do not commit a real value.
AUTH_SECRET="replace-with-a-random-secret"

# Optional Google sign-in. The account button stays inactive until both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public site origin used for absolute links and callbacks.
APP_BASE_URL="https://tjayjeweler.com"

# Optional CLI seed for card-transfer checkout (`npm run seed:bank`).
# BANK_CARD_NUMBER=6037991122334455
# BANK_CARD_HOLDER="TJAY JEWELER"
# BANK_NAME="Melli"

# Optional legacy Zarinpal credentials (unused after card-transfer checkout).
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true
