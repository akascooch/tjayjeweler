generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String?  @unique
  email         String?  @unique
  password_hash String?
  name          String?
  role          Role     @default(CUSTOMER)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  orders        Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  products    Product[]
}

model Product {
  id          String           @id @default(cuid())
  category_id String
  category    Category         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  title       String
  slug        String           @unique
  description String
  /// Alloy code such as 925.
  purity      String
  base_weight Decimal          @db.Decimal(10, 3)
  status      ProductStatus    @default(DRAFT)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([category_id])
}

model ProductImage {
  id         String  @id @default(cuid())
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  url        String
  alt_text   String
  is_primary Boolean @default(false)

  @@index([product_id])
}

model ProductVariant {
  id                String                 @id @default(cuid())
  product_id        String
  product           Product                @relation(fields: [product_id], references: [id], onDelete: Restrict)
  sku               String                 @unique
  ring_size         String?
  chain_length      String?
  additional_weight Decimal                @default(0) @db.Decimal(10, 3)
  stock_quantity    Int                    @default(0)
  price             Decimal                @db.Decimal(12, 2)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  reservations      InventoryReservation[]
  order_items       OrderItem[]

  @@index([product_id])
}

model InventoryReservation {
  id         String         @id @default(cuid())
  variant_id String
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  session_id String
  expires_at DateTime
  created_at DateTime       @default(now())

  @@unique([variant_id, session_id])
  @@index([expires_at])
}

model Order {
  id              String      @id @default(cuid())
  user_id         String?     @db.Uuid
  user            User?       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING)
  currency        String      @default("IRT")
  payment_gateway String?
  tracking_code   String?     @unique
  paid_at         DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  items           OrderItem[]

  @@index([user_id])
}

model OrderItem {
  id         String         @id @default(cuid())
  order_id   String
  order      Order          @relation(fields: [order_id], references: [id], onDelete: Restrict)
  variant_id String
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  quantity   Int
  unit_price Decimal        @db.Decimal(12, 2)

  @@index([order_id])
  @@index([variant_id])
}
